{
  "name": "stm-openssl",
  "version": "6.1.0",
  "author": "stm",
  "summary": "Create and deploy X.509 certificates, keys and Diffie-Hellman parameter files",
  "license": "BSD-2-Clause",
  "source": "https://github.com/smoeding/puppet-openssl",
  "project_page": "https://github.com/smoeding/puppet-openssl",
  "issues_url": "https://github.com/smoeding/puppet-openssl/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 5.1.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/concat",
      "version_requirement": ">= 5.1.0 < 11.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "11",
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "20.04",
        "22.04",
        "24.04",
        "26.04"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "OracleLinux",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.19.0 < 9.0.0"
    }
  ],
  "tags": [
    "openssl",
    "certutil",
    "x509",
    "certificate"
  ]
}
